# Copy to .env. Credentials are server-side; never commit the populated file.
HOST=127.0.0.1
PORT=8787
OPENAI_API_KEY=
# Existing research fallback. Choose account-supported Responses/structured-output
# models; search workers also need web_search. Pin model snapshots when available.
OPENAI_MODEL=
# Strong planning, elicitation and critical review; falls back to OPENAI_MODEL.
OPENAI_ORCHESTRATOR_MODEL=
# Explicit lower-cost worker for search and probability-study extraction.
# Required for live Probability Lab preparation. No paid model is silently selected.
OPENAI_WORKER_MODEL=
# Optional. Probability Lab can instead use any configured grunt/harness agent.
# When present, Jev provides batched local estimates; standard research can use its relevance diagnostic.
# Neither route is empirically calibrated or automatically a likelihood ratio.
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0
# Required with bare HTTPS PUBLIC_ORIGIN for remote access. Minimum 24 random characters.
VERACITY_ACCESS_TOKEN=
PUBLIC_ORIGIN=
# Private persistent volume; the scale database lives under probability-scale/.
VERACITY_DATA_DIR=

# Optional harness-agnostic agent registry. If omitted, direct OpenAI roles above
# remain the backwards-compatible defaults. Copy agents.example.json to agents.json.
VERACITY_AGENT_CONFIG=
VERACITY_ORCHESTRATOR_AGENT=
VERACITY_WORKER_AGENT=
# Optional executable overrides used by the bundled CLI bridge scripts.
VERACITY_CODEX_BIN=
VERACITY_CLAUDE_BIN=
VERACITY_GEMINI_BIN=
VERACITY_HARNESS_TIMEOUT_MS=180000
