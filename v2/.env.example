# Copy to .env. Credentials are server-side; never commit the populated file.
HOST=127.0.0.1
PORT=8787
OPENAI_API_KEY=
# Existing research fallback. Choose account-supported Responses/structured-output
# models; search workers also need web_search. Pin model snapshots when available.
OPENAI_MODEL=
# Strong planning, elicitation and critical review; falls back to OPENAI_MODEL.
OPENAI_ORCHESTRATOR_MODEL=
# Explicit lower-cost worker for search and probability-study extraction.
# Required for live Probability Lab preparation. No paid model is silently selected.
OPENAI_WORKER_MODEL=
# Probability Lab: batched local estimates. Standard research: relevance diagnostic.
# Neither is empirically calibrated or automatically a likelihood ratio.
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0
# Required with bare HTTPS PUBLIC_ORIGIN for remote access. Minimum 24 random characters.
VERACITY_ACCESS_TOKEN=
PUBLIC_ORIGIN=
# Private persistent volume; the scale database lives under probability-scale/.
VERACITY_DATA_DIR=
