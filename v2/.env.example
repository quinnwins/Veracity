# Keep this file as an example. Copy it to .env; never commit credentials.
HOST=127.0.0.1
PORT=8787
# Required only for live research. Choose a model available to your account
# that supports the Responses API, strict structured output, and web_search.
# Prefer a pinned version; requested and returned versions are recorded.
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional semantic relevance diagnostic. It does not set the truth posterior.
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0
# Optional on loopback. REQUIRED with HTTPS PUBLIC_ORIGIN for remote hosting.
# Generate a random token of at least 24 characters, not a memorable password.
VERACITY_ACCESS_TOKEN=
PUBLIC_ORIGIN=
# Default: v2/.data. Use a private persistent volume for deployment.
VERACITY_DATA_DIR=
